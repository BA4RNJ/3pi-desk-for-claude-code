{
  "name": "claude-desk",
  "version": "0.4.3",
  "description": "3PI Desk for Claude Code - a local GUI for Claude Code",
  "main": "./out/main/index.js",
  "author": "BA4RNJ",
  "license": "MIT",
  "private": true,
  "desktopName": "3pi-desk",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BA4RNJ/3pi-desk-for-claude-code.git"
  },
  "bugs": {
    "url": "https://github.com/BA4RNJ/3pi-desk-for-claude-code/issues"
  },
  "homepage": "https://github.com/BA4RNJ/3pi-desk-for-claude-code#readme",
  "keywords": [
    "claude-code",
    "claude-code-gui",
    "claude-code-desktop",
    "claude-code-chinese",
    "claude-code-graphical",
    "anthropic-compatible",
    "deepseek",
    "kimi",
    "moonshot",
    "glm",
    "zai",
    "minimax",
    "ollama",
    "wsl",
    "wslg",
    "macos",
    "electron",
    "react",
    "typescript",
    "desktop-app"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p packages/agent-bridge/tsconfig.json",
    "test": "sh scripts/native/build-bridge.sh && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/*.test.mjs scripts/native/*.test.mjs",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "prepackage": "node node_modules/electron/install.js",
    "package": "npm run build && electron-builder --dir",
    "prepackage:linux": "node node_modules/electron/install.js",
    "package:linux": "npm run build && electron-builder --linux dir",
    "prepackage:mac": "node node_modules/electron/install.js",
    "package:mac": "npm run build && electron-builder --mac dir",
    "prepackage:wsl": "node node_modules/electron/install.js",
    "package:wsl": "npm run build && electron-builder --linux dir --config electron-builder.wsl.yml",
    "prepackage:offline": "node node_modules/electron/install.js",
    "package:offline": "npm run build && electron-builder --dir --config electron-builder.offline.yml",
    "predist": "node node_modules/electron/install.js",
    "dist": "npm run build && electron-builder",
    "predist:linux": "node node_modules/electron/install.js",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "predist:mac": "node node_modules/electron/install.js",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "predist:wsl": "node node_modules/electron/install.js",
    "dist:wsl": "npm run build && electron-builder --linux AppImage deb --config electron-builder.wsl.yml",
    "predist:offline": "node node_modules/electron/install.js",
    "dist:linux:offline": "npm run build && electron-builder --linux AppImage deb --config electron-builder.offline.yml",
    "dist:mac:offline": "npm run build && electron-builder --mac dmg zip --config electron-builder.offline.yml"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "diff": "^9.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.70.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "rolldown": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
